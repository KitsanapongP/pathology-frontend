# Optional host port used by Docker Compose. No credentials belong in this file.
FRONTEND_PORT=3000
# Show small skip-login shortcuts while backend users are unavailable. Use api to hide them.
NEXT_PUBLIC_AUTH_MODE=demo
# NEXT_PUBLIC_* values are visible to the browser and fixed at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:9100
# Dev: http://<DEV_IP>:9100 (same network or VPN; keep the real IP in .env.local).
# Prod: http://portal.<domain> (domain pending backend confirmation).
# Request service uses port 8000 separately; its business APIs are not ready.
# The client adds /v1. Do not put a token in an environment variable.
